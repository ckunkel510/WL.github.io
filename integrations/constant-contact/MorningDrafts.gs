    const prop='WL_MORNING_NATIVE_'+draft.key.toUpperCase();let saved=JSON.parse(getProp_(prop)||'null');
    if(!saved){const collision=existing.find(function(x){return x.name===draft.name;});let campaign;if(collision){campaign=ccGet_('/emails/'+collision.campaign_id);}else{campaign=ccPost_('/emails',{name:draft.name,email_campaign_activities:[{format_type:5,from_name:sender.from_name,from_email:sender.from_email,reply_to_email:sender.reply_to_email,subject:draft.subject,preheader:draft.preheader,html_content:draft.html}]},'Create unsent morning draft failed');}
      const primary=(campaign.campaign_activities||[]).find(function(x){return x.role==='primary_email';});if(!campaign.campaign_id||!primary)throw new Error('Unsent campaign acknowledgement missing');saved={campaignId:campaign.campaign_id,activityId:primary.campaign_activity_id,key:draft.key};setProp_(prop,JSON.stringify(saved));
    }
