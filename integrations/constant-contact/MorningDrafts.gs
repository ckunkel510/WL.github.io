  });
  const results=checked.map(function(item){const d=item.draft,c=item.current;
    if(item.needsUpdate)ccPut_('/emails/activities/'+d.activityId,{format_type:5,from_name:c.from_name,from_email:c.from_email,reply_to_email:c.reply_to_email,subject:c.subject,preheader:c.preheader,html_content:d.html,contact_list_ids:[],segment_ids:[]},'Save owner-requested visual draft failed');
    const saved=ccGet_('/emails/activities/'+d.activityId+'?include=html_content,physical_address_in_footer');
    if(saved.current_status!=='DRAFT'||saved.html_content!==d.html||saved.from_name!==c.from_name||saved.from_email!==c.from_email||saved.reply_to_email!==c.reply_to_email||saved.subject!==c.subject||saved.preheader!==c.preheader||JSON.stringify(saved.physical_address_in_footer)!==JSON.stringify(c.physical_address_in_footer)||(saved.contact_list_ids||[]).length||(saved.segment_ids||[]).length)throw new Error('Saved draft verification failed');
    return {key:d.key,campaignId:d.campaignId,activityId:d.activityId,revision:'r2',status:saved.current_status,exactHtmlVerified:true,senderAndFooterPreserved:true,updated:item.needsUpdate,audienceSelected:false,releaseApproved:false};
  });
  const result={ok:true,checkedAt:new Date().toISOString(),drafts:results,campaignsSent:0,scheduled:0,ownerCreativeApprovalRequired:true};setProp_('WL_MORNING_VISUAL_REVISION',JSON.stringify(result));console.log(JSON.stringify(result));return result;
}
