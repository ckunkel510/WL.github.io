    result.push(Object.assign({},saved,{name:draft.name,subject:activity.subject,status:activity.current_status,formatType:activity.format_type,exactHtmlVerified:true,profileLinkTagPresent:activity.html_content.indexOf('[[updateLink]]')>=0,trackingImageTagPresent:activity.html_content.indexOf('[[trackingImage]]')>=0,nativeFooterAddressConfigured:!!activity.physical_address_in_footer,audienceSelected:false,releaseApproved:false}));
  });
